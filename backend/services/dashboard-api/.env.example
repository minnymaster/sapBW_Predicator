PORT=3005
NODE_ENV=development

# JWT RS256 — публичный ключ от manage-api (только проверка)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0B...\n-----END PUBLIC KEY-----"

# Redis — кэш (5 мин) и хранение состояния задач
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URL внутренних сервисов (Docker: имена контейнеров; локально: localhost:PORT)
REPORTS_API_URL=http://localhost:3004
TESTS_API_URL=http://localhost:3001

# Таймаут межсервисных HTTP запросов (мс)
HTTP_TIMEOUT_MS=10000
