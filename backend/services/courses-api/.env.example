COURSES_DATABASE_URL=postgresql://courses_user:courses_pass@localhost:5433/courses_db

PORT=3003

# JWT RS256 — публичный ключ общий с manage-api (тот же ключевой материал)
# Если ключи отсутствуют — KeysService сгенерирует их автоматически при старте
# В продакшне монтировать тот же каталог, что и у manage-api
JWT_KEYS_DIR=./keys
