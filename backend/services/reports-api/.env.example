PORT=3004
NODE_ENV=development

# PostgreSQL — company_db (основная БД для отчётов)
COMPANY_DATABASE_URL="postgresql://company_user:company_pass@localhost:5432/company_db?schema=public"

# PostgreSQL — certification_db (только чтение: попытки, результаты)
CERTIFICATION_DATABASE_URL="postgresql://certification_user:certification_pass@localhost:5434/certification_db?schema=public"

# JWT RS256 — публичный ключ от manage-api (только проверка, не выпуск)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0B...\n-----END PUBLIC KEY-----"
