COMPANY_DATABASE_URL=postgresql://manage_user:manage_pass@localhost:5434/company_db

# QuestionsModule: manage-api читает/пишет вопросы напрямую в certification_db
# (только для generate — миграции управляет tests-api)
CERTIFICATION_DATABASE_URL=postgresql://cert_user:cert_pass@localhost:5433/certification_db

PORT=3002

# Redis — pub/sub для событий назначений (AssignmentsModule → уведомления)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # раскомментировать если Redis требует auth

# Путь к каталогу с RSA-ключами (JWT RS256)
# Если ключи отсутствуют — KeysService сгенерирует их автоматически при старте
JWT_KEYS_DIR=./keys

# TTL токена (должен совпадать с JWT_TTL_SECONDS = 900)
JWT_EXPIRES_IN=15m